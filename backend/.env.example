# ===== Django =====
DJANGO_SECRET_KEY=jd-demo-change-me
DJANGO_DEBUG=true

# ===== 数据库 =====
# sqlite：零配置演示（默认，开箱即用）
# mysql ：需要本机 MySQL 8.0，首次启动会自动 CREATE DATABASE IF NOT EXISTS
DB_ENGINE=sqlite

# 以下四项仅在 DB_ENGINE=mysql 时生效；密码为空时启动脚本会提示你填写
DB_NAME=jdshop
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
